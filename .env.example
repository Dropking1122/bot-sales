# Server Configuration
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://bot_sales_user:BotSalesSecurePass2026!@localhost:5432/bot_sales_db?schema=public"

# Redis (BullMQ Queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_bot_sales_2026_change_in_production
JWT_EXPIRES_IN=7d

# Storage Paths
STORAGE_DIR=/root/bot-sales/storage
UPLOAD_DIR=/root/bot-sales/storage/uploads
WHATSAPP_SESSION_DIR=/root/bot-sales/storage/whatsapp-session

# WhatsApp Bot Settings
WHATSAPP_AUTO_REPLY_ENABLED=true
WHATSAPP_SIMULATION_DELAY_MS=1500
WHATSAPP_DEFAULT_TIMEZONE=Asia/Jakarta

# Super Admin Initial Seed
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL="admin@botsales.local"
SUPER_ADMIN_PASSWORD="AdminPassword2026!"
