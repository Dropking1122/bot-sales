# Server Configuration
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Never commit a real credential here.
DATABASE_URL="postgresql://bot_sales_user:CHANGE_ME@localhost:5432/bot_sales_db?schema=public"

# Redis (BullMQ Queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
# Generate with: openssl rand -hex 32   (minimum 32 chars; the server refuses to start otherwise)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Storage Paths
STORAGE_DIR=/root/bot-sales/storage
UPLOAD_DIR=/root/bot-sales/storage/uploads
WHATSAPP_SESSION_DIR=/root/bot-sales/storage/whatsapp-session

# WhatsApp Bot Settings
WHATSAPP_AUTO_REPLY_ENABLED=true
WHATSAPP_SIMULATION_DELAY_MS=1500
WHATSAPP_DEFAULT_TIMEZONE=Asia/Jakarta

# Super Admin Initial Seed
# Required by `npm run prisma:seed` (minimum 12 chars). The seed never re-applies this to an
# existing account, so changing it after the first run does not reset a rotated password.
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL="admin@botsales.local"
SUPER_ADMIN_PASSWORD=

# Break-glass passkey for POST /api/auth/passkey. Leave empty to disable that endpoint entirely
# (it answers 503). Use a long random value: openssl rand -hex 24
ADMIN_PASSKEY=

# Optional: API key for the AI agent provider, used when the ai_api_key setting is empty.
OPENAI_API_KEY=

# AI provider allow-list. /api/settings/test-ai calls the provider with the stored credential, so
# only these origins may be named. The value stored as the `ai_provider_url` setting is always
# allowed; AI_ALLOWED_PROVIDER_HOSTS adds extra origins (comma separated host[:port]).
AI_PROVIDER_URL=http://127.0.0.1:20128/v1
AI_ALLOWED_PROVIDER_HOSTS=
